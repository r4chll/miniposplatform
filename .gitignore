# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system.
.DS_Store
*.swp
*~

# Ignore bundler config.
/.bundle

# Ignore the encryption key for the credentials file. config/credentials.yml.enc
# is committed and is useless without it; this must never be.
/config/master.key

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore test coverage reports. The percentage is published as a README badge
# and enforced by SimpleCov; the generated HTML does not belong in git.
/coverage/
